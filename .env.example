# 豆包语音（Duplex 全双工）——语音对话必需
DOUBAO_API_KEY=
# 火山引擎 Ark（导演 LLM + Seedream 生图）——剧情推进/动态生图必需
SEED_API_KEY=
TYPESAFE_API_KEY=
# Jev现场判断和续话节奏；配置 key 后默认开启，0 可关闭。
# JEV_ENABLED=1
# TYPESAFE_DEFAULT_MODEL=jev-latest

# 可选覆盖
# PORT=8787
# DUPLEX_MODEL=1.2.6.1
# MIRA_VOICE=zh_female_vv_jupiter_bigtts
# INJECT_VOICE=zh_male_yunzhou_jupiter_bigtts   # 打字注入的用户话音（duplex 仅支持 *_jupiter_bigtts）
# DIRECTOR_MODEL=doubao-seed-1-6-flash-250828
# GENIMG_MODEL=doubao-seedream-4-5-251128
# GENIMG_SIZE=2560x1440
# RECORD=1        # 录制会话到 recordings/（供 build-mock 打包回放）
# MOCK=1          # 服务端无 key 时也会标记 mock

# 上线部署
# ACCESS_TOKENS=code1,code2   # 访问口令，逗号分隔多个；不设 = 不启用鉴权（本地开发留空）
# MAX_SESSIONS=10             # 同时在线会话上限，超出返回 busy

# Persist explored locations/map/media on a durable volume in production.
WORLD_DATA_DIR=./data/worlds
# Set 0 to keep visited regions usable with scene thumbnails, without paid map generation.
MAP_IMAGES=1
