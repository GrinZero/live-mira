{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mira:photo-semantics:live-report:v1",
  "type": "object",
  "required": ["schemaVersion", "datasetId", "datasetVersion", "execution", "summary", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "datasetId": { "const": "mira-photo-semantics-regression-v1" },
    "datasetVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "execution": {
      "type": "object",
      "required": ["kind", "model", "startedAt", "finishedAt"],
      "properties": {
        "kind": { "const": "provider_live" },
        "model": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "passRate"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "cases": { "type": "array", "minItems": 1, "maxItems": 25 }
  },
  "additionalProperties": false
}
